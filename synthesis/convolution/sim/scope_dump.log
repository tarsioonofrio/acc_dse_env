1476:       return RESIZE(QUOT, L'LENGTH);
1477:     end if;
1478:     XR := TO_SIGNED(R, R_LENGTH);
1479:     QUOT := RESIZE((L / XR), QUOT'LENGTH);
1480:     return RESIZE(QUOT, L'LENGTH);
1481:   end "/";
