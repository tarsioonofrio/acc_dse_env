3165:   -- Id: M.1
3166:   function STD_MATCH (L, R: STD_ULOGIC) return BOOLEAN is
3167:     variable VALUE: STD_ULOGIC;
3168:   begin
3169:     return MATCH_TABLE(L, R);
3170:   end STD_MATCH;
