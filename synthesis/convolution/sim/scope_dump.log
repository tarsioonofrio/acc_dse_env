1787:   function ">" (L, R: UNSIGNED) return BOOLEAN is
1788:     constant L_LEFT: INTEGER := L'LENGTH-1;
1789:     constant R_LEFT: INTEGER := R'LENGTH-1;
1790:     alias XL: UNSIGNED(L_LEFT downto 0) is L;
1791:     alias XR: UNSIGNED(R_LEFT downto 0) is R;
1792:     constant SIZE: NATURAL := MAX(L'LENGTH, R'LENGTH);
1793:     variable L01 : UNSIGNED(L_LEFT downto 0);
1794:     variable R01 : UNSIGNED(R_LEFT downto 0);
1795:   begin
1796:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then
1797:       assert NO_WARNING
1798:           report "NUMERIC_STD."">"": null argument detected, returning FALSE"
1799:           severity WARNING;
1800:       return FALSE;
1801:     end if;
1802:     L01 := TO_01(XL, 'X');
1803:     R01 := TO_01(XR, 'X');
1804:     if ((L01(L01'LEFT)='X') or (R01(R01'LEFT)='X')) then
1805:       assert NO_WARNING
1806:           report "NUMERIC_STD."">"": metavalue detected, returning FALSE"
1807:           severity WARNING;
1808:       return FALSE;
1809:     end if;
1810:     return not UNSIGNED_LESS_OR_EQUAL(RESIZE(L01, SIZE), RESIZE(R01, SIZE));
1811:   end ">";
