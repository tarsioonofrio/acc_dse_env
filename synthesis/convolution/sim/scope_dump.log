 903:     FUNCTION To_bit       ( s : std_ulogic        
 904:     --synopsys synthesis_off
 905: 			    ; xmap : BIT := '0'
 906:     --synopsys synthesis_on
 907: 			  ) RETURN BIT IS
 908:     -- pragma built_in SYN_FEED_THRU
 909:     -- pragma subpgm_id 205
 910:     BEGIN
 911:     --synopsys synthesis_off
 912:             CASE s IS
 913:                 WHEN '0' | 'L' => RETURN ('0');
 914:                 WHEN '1' | 'H' => RETURN ('1');
 915:                 WHEN OTHERS => RETURN xmap;
 916:             END CASE;
 917:     --synopsys synthesis_on
 918:     END;
 919:     --------------------------------------------------------------------
 920:     FUNCTION To_bitvector ( s : std_logic_vector 
 921:     --synopsys synthesis_off
 922: 			    ; xmap : BIT := '0'
 923:     --synopsys synthesis_on
 924: 			  ) RETURN BIT_VECTOR IS
 925:     -- pragma built_in SYN_FEED_THRU
 926:     -- pragma subpgm_id 206
 927:     --synopsys synthesis_off
 928:         ALIAS sv : std_logic_vector ( s'LENGTH-1 DOWNTO 0 ) IS s;
 929:         VARIABLE result : BIT_VECTOR ( s'LENGTH-1 DOWNTO 0 );
 930:     --synopsys synthesis_on
 931:     BEGIN
 932:     --synopsys synthesis_off
 933:         FOR i IN result'RANGE LOOP
 934:             CASE sv(i) IS
 935:                 WHEN '0' | 'L' => result(i) := '0';
 936:                 WHEN '1' | 'H' => result(i) := '1';
 937:                 WHEN OTHERS => result(i) := xmap;
 938:             END CASE;
 939:         END LOOP;
 940:         RETURN result;
 941:     --synopsys synthesis_on
 942:     END;
 943:     --------------------------------------------------------------------
 944:     FUNCTION To_bitvector ( s : std_ulogic_vector
 945:     --synopsys synthesis_off
 946: 			    ; xmap : BIT := '0'
 947:     --synopsys synthesis_on
 948: 			  ) RETURN BIT_VECTOR IS
 949:     -- pragma built_in SYN_FEED_THRU
 950:     -- pragma subpgm_id 207
 951:     --synopsys synthesis_off
 952:         ALIAS sv : std_ulogic_vector ( s'LENGTH-1 DOWNTO 0 ) IS s;
 953:         VARIABLE result : BIT_VECTOR ( s'LENGTH-1 DOWNTO 0 );
 954:     --synopsys synthesis_on
 955:     BEGIN
 956:     --synopsys synthesis_off
 957:         FOR i IN result'RANGE LOOP
 958:             CASE sv(i) IS
 959:                 WHEN '0' | 'L' => result(i) := '0';
 960:                 WHEN '1' | 'H' => result(i) := '1';
 961:                 WHEN OTHERS => result(i) := xmap;
 962:             END CASE;
 963:         END LOOP;
 964:         RETURN result;
 965:     --synopsys synthesis_on
 966:     END;
