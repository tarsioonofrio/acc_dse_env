2543:     return RESULT;
2544:   end "xor";
2545: 
2546:   ------------------------------------------------------------------------------
2547:   -- Note : Function L.14 is not compatible with VHDL 1076-1987. Comment
2548:   -- out the function (declaration and body) for VHDL 1076-1987 compatibility.
2549:   ------------------------------------------------------------------------------
2550:   -- Id: L.14
2551:   function "xnor" (L, R: SIGNED) return SIGNED is
2552:     variable RESULT: SIGNED(L'LENGTH-1 downto 0);
2553:   begin
2554:     RESULT := SIGNED(BIT_VECTOR(L) xnor BIT_VECTOR(R));
2555:     return RESULT;
2556:   end "xnor";
2557: 
2558:   --============================================================================
2559: 
2560:   -- Id: E.1
2561:   function RISING_EDGE (signal S: BIT) return BOOLEAN is
2562:   begin
2563:     return S'EVENT and S = '1';
2564:   end RISING_EDGE;
2565: 
2566:   -- Id: E.2
2567:   function FALLING_EDGE (signal S: BIT) return BOOLEAN is
2568:   begin
2569:     return S'EVENT and S = '0';
2570:   end FALLING_EDGE;
2571: 
2572:   --============================================================================
2573: end NUMERIC_BIT;

CHILD_SCOPES(@IEEE.std_logic_1164)= 256: PACKAGE BODY std_logic_1164 IS
 257:     -------------------------------------------------------------------    
 258:     -- local types
 259:     -------------------------------------------------------------------    
 260:     --synopsys synthesis_off 
 261:     TYPE stdlogic_1d IS ARRAY (std_ulogic) OF std_ulogic;
 262:     TYPE stdlogic_table IS ARRAY(std_ulogic, std_ulogic) OF std_ulogic;
 263: 
 264:     -------------------------------------------------------------------    
 265:     -- resolution function
 266:     -------------------------------------------------------------------    
 267:     CONSTANT resolution_table : stdlogic_table := (
 268:     --      ---------------------------------------------------------
 269:     --      |  U    X    0    1    Z    W    L    H    -        |   |  
 270:     --      ---------------------------------------------------------
 271:             ( 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U' ), -- | U |
 272:             ( 'U', 'X', 'X', 'X', 'X', 'X', 'X', 'X', 'X' ), -- | X |
 273:             ( 'U', 'X', '0', 'X', '0', '0', '0', '0', 'X' ), -- | 0 |
 274:             ( 'U', 'X', 'X', '1', '1', '1', '1', '1', 'X' ), -- | 1 |
 275:             ( 'U', 'X', '0', '1', 'Z', 'W', 'L', 'H', 'X' ), -- | Z |
 276:             ( 'U', 'X', '0', '1', 'W', 'W', 'W', 'W', 'X' ), -- | W |
 277:             ( 'U', 'X', '0', '1', 'L', 'W', 'L', 'W', 'X' ), -- | L |
 278:             ( 'U', 'X', '0', '1', 'H', 'W', 'W', 'H', 'X' ), -- | H |
 279:             ( 'U', 'X', 'X', 'X', 'X', 'X', 'X', 'X', 'X' )  -- | - |
 280:         );
 281:     --synopsys synthesis_on
 282:         
 283:     FUNCTION resolved ( s : std_ulogic_vector ) RETURN std_ulogic IS
 284:         -- pragma resolution_method three_state
 285:         -- pragma subpgm_id 183
 286:         --synopsys synthesis_off 
 287:         VARIABLE result : std_ulogic := 'Z';  -- weakest state default
 288:         --synopsys synthesis_on    
 289:     BEGIN
 290:         -- the test for a single driver is essential otherwise the
 291:         -- loop would return 'X' for a single driver of '-' and that
 292:         -- would conflict with the value of a single driver unresolved
 293:         -- signal.
 294:         --synopsys synthesis_off
 295:         IF    (s'LENGTH = 1) THEN    RETURN s(s'LOW);
 296:         ELSE
 297:             FOR i IN s'RANGE LOOP
 298:                 result := resolution_table(result, s(i));
 299:             END LOOP;
 300:         END IF;
 301:         RETURN result;
 302:         --synopsys synthesis_on
 303:     END resolved;
