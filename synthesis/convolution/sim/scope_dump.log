1730:   begin
1731:     -- AVSREQ-156748: If both L and R are null-range REAL_VECTOR, then their length would match as 0.
1732:     -- So, return true for this case also.
1733:     if L'length /= R'length then --or L'length < 1 or R'length < 1 then
1734:       return false;
1735:     else
1736:       for i in l'range loop
1737:         if L(i) /= R(i) then
1738:           return false;
1739:         end if;
1740:       end loop;
1741:       return true;
1742:     end if;
1743:   end function "=";
