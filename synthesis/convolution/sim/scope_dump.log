2934:   -- Id: D.3
2935:   function TO_UNSIGNED (ARG, SIZE: NATURAL) return UNSIGNED is
2936:     variable RESULT: UNSIGNED(SIZE-1 downto 0);
2937:     variable I_VAL: NATURAL := ARG;
2938:   begin
2939:     if (SIZE < 1) then return NAU;
2940:     end if;
2941:     for I in 0 to RESULT'LEFT loop
2942:       if (I_VAL mod 2) = 0 then
2943:         RESULT(I) := '0';
2944:       else RESULT(I) := '1';
2945:       end if;
2946:       I_VAL := I_VAL/2;
2947:     end loop;
2948:     if not(I_VAL =0) then
2949:       assert NO_WARNING
2950:           report "NUMERIC_STD.TO_UNSIGNED: vector truncated"
2951:           severity WARNING;
2952:     end if;
2953:     return RESULT;
2954:   end TO_UNSIGNED;
2955: 
2956:   -- Id: D.4
2957:   function TO_SIGNED (ARG: INTEGER; SIZE: NATURAL) return SIGNED is
2958:     variable RESULT: SIGNED(SIZE-1 downto 0);
2959:     variable B_VAL: STD_LOGIC := '0';
2960:     variable I_VAL: INTEGER := ARG;
2961:   begin
2962:     if (SIZE < 1) then return NAS;
2963:     end if;
2964:     if (ARG < 0) then
2965:       B_VAL := '1';
2966:       I_VAL := -(ARG+1);
2967:     end if;
2968:     for I in 0 to RESULT'LEFT loop
2969:       if (I_VAL mod 2) = 0 then
2970:         RESULT(I) := B_VAL;
2971:       else
2972:         RESULT(I) := not B_VAL;
2973:       end if;
2974:       I_VAL := I_VAL/2;
2975:     end loop;
2976:     if ((I_VAL/=0) or (B_VAL/=RESULT(RESULT'LEFT))) then
2977:       assert NO_WARNING
2978:           report "NUMERIC_STD.TO_SIGNED: vector truncated"
2979:           severity WARNING;
2980:     end if;
2981:     return RESULT;
2982:   end TO_SIGNED;
