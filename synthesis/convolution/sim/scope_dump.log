1369:   -- Id: A.21
1370:   function "/" (L, R: UNSIGNED) return UNSIGNED is
1371:     constant L_LEFT: INTEGER := L'LENGTH-1;
1372:     constant R_LEFT: INTEGER := R'LENGTH-1;
1373:     alias XXL: UNSIGNED(L_LEFT downto 0) is L;
1374:     alias XXR: UNSIGNED(R_LEFT downto 0) is R;
1375:     variable XL: UNSIGNED(L_LEFT downto 0);
1376:     variable XR: UNSIGNED(R_LEFT downto 0);
1377:     variable FQUOT: UNSIGNED(L'LENGTH-1 downto 0);
1378:     variable FREMAIN: UNSIGNED(R'LENGTH-1 downto 0);
1379:   begin
1380:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAU;
1381:     end if;
1382:     XL := TO_01(XXL, 'X');
1383:     XR := TO_01(XXR, 'X');
1384:     if ((XL(XL'LEFT)='X') or (XR(XR'LEFT)='X')) then
1385:       FQUOT := (others => 'X');
1386:       return FQUOT;
1387:     end if;
1388:     DIVMOD(XL, XR, FQUOT, FREMAIN);
1389:     return FQUOT;
1390:   end "/";
1391: 
1392:   -- Id: A.22
1393:   function "/" (L, R: SIGNED) return SIGNED is
1394:     constant L_LEFT: INTEGER := L'LENGTH-1;
1395:     constant R_LEFT: INTEGER := R'LENGTH-1;
1396:     alias XXL: SIGNED(L_LEFT downto 0) is L;
1397:     alias XXR: SIGNED(R_LEFT downto 0) is R;
1398:     variable XL: SIGNED(L_LEFT downto 0);
1399:     variable XR: SIGNED(R_LEFT downto 0);
1400:     variable FQUOT: UNSIGNED(L'LENGTH-1 downto 0);
1401:     variable FREMAIN: UNSIGNED(R'LENGTH-1 downto 0);
1402:     variable XNUM: UNSIGNED(L'LENGTH-1 downto 0);
1403:     variable XDENOM: UNSIGNED(R'LENGTH-1 downto 0);
1404:     variable QNEG: BOOLEAN := FALSE;
1405:   begin
1406:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAS;
1407:     end if;
1408:     XL := TO_01(XXL, 'X');
1409:     XR := TO_01(XXR, 'X');
1410:     if ((XL(XL'LEFT)='X') or (XR(XR'LEFT)='X')) then
1411:       FQUOT := (others => 'X');
1412:       return SIGNED(FQUOT);
1413:     end if;
1414:     if XL(XL'LEFT)='1' then
1415:       XNUM := UNSIGNED(-XL);
1416:       QNEG := TRUE;
1417:     else
1418:       XNUM := UNSIGNED(XL);
1419:     end if;
1420:     if XR(XR'LEFT)='1' then
1421:       XDENOM := UNSIGNED(-XR);
1422:       QNEG := not QNEG;
1423:     else
1424:       XDENOM := UNSIGNED(XR);
1425:     end if;
1426:     DIVMOD(XNUM, XDENOM, FQUOT, FREMAIN);
1427:     if QNEG then FQUOT := "0"-FQUOT;
1428:     end if;
1429:     return SIGNED(FQUOT);
1430:   end "/";
