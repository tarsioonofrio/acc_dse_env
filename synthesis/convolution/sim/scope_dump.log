1062:   -----------------Local Subprograms - Relational ops---------------------------
1063: 
1064:   --
1065:   -- General "=" for UNSIGNED vectors, same length
1066:   --
1067:   function UNSIGNED_EQUAL (L, R: UNSIGNED) return BOOLEAN is
1068:   begin
1069:     return STD_LOGIC_VECTOR(L) = STD_LOGIC_VECTOR(R);
1070:   end UNSIGNED_EQUAL;
1071: 
1072:   --
1073:   -- General "=" for SIGNED vectors, same length
1074:   --
1075:   function SIGNED_EQUAL (L, R: SIGNED) return BOOLEAN is
1076:   begin
1077:     return STD_LOGIC_VECTOR(L) = STD_LOGIC_VECTOR(R);
1078:   end SIGNED_EQUAL;
1079: 
1080:   --
1081:   -- General "<" for UNSIGNED vectors, same length
1082:   --
1083:   function UNSIGNED_LESS (L, R: UNSIGNED) return BOOLEAN is
1084:   begin
1085:     return STD_LOGIC_VECTOR(L) < STD_LOGIC_VECTOR(R);
1086:   end UNSIGNED_LESS;
1087: 
1088:   --
1089:   -- General "<" function for SIGNED vectors, same length
1090:   --
1091:   function SIGNED_LESS (L, R: SIGNED) return BOOLEAN is
1092:     variable INTERN_L: SIGNED(0 to L'LENGTH-1);
1093:     variable INTERN_R: SIGNED(0 to R'LENGTH-1);
1094:   begin
1095:     INTERN_L := L;
1096:     INTERN_R := R;
1097:     INTERN_L(0) := not INTERN_L(0);
1098:     INTERN_R(0) := not INTERN_R(0);
1099:     return STD_LOGIC_VECTOR(INTERN_L) < STD_LOGIC_VECTOR(INTERN_R);
1100:   end SIGNED_LESS;
1101: 
1102:   --
1103:   -- General "<=" function for UNSIGNED vectors, same length
1104:   --
1105:   function UNSIGNED_LESS_OR_EQUAL (L, R: UNSIGNED) return BOOLEAN is
1106:   begin
1107:     return STD_LOGIC_VECTOR(L) <= STD_LOGIC_VECTOR(R);
1108:   end UNSIGNED_LESS_OR_EQUAL;
1109: 
1110:   --
1111:   -- General "<=" function for SIGNED vectors, same length
1112:   --
1113:   function SIGNED_LESS_OR_EQUAL (L, R: SIGNED) return BOOLEAN is
1114:     -- Need aliases to assure index direction
1115:     variable INTERN_L: SIGNED(0 to L'LENGTH-1);
1116:     variable INTERN_R: SIGNED(0 to R'LENGTH-1);
1117:   begin
1118:     INTERN_L := L;
1119:     INTERN_R := R;
1120:     INTERN_L(0) := not INTERN_L(0);
1121:     INTERN_R(0) := not INTERN_R(0);
1122:     return STD_LOGIC_VECTOR(INTERN_L) <= STD_LOGIC_VECTOR(INTERN_R);
1123:   end SIGNED_LESS_OR_EQUAL;
