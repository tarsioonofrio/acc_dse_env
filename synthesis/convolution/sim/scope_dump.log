 429:     function mult(A,B: SIGNED) return SIGNED is
 430: 
 431:       variable BA: SIGNED((A'length+B'length-1) downto 0);
 432:       variable PA: SIGNED((A'length+B'length-1) downto 0);
 433:       variable AA: SIGNED(A'length downto 0);
 434:       variable neg: STD_ULOGIC;
 435:       constant one : UNSIGNED(1 downto 0) := "01";
 436:       
 437:       -- pragma map_to_operator MULT_TC_OP
 438:       -- pragma type_function MULT_SIGNED_ARG
 439:       -- pragma return_port_name Z
 440: 
 441:       begin
 442: 	if (A(A'left) = 'X' or B(B'left) = 'X') then
 443:             PA := (others => 'X');
 444:             return(PA);
 445: 	end if;
 446:         PA := (others => '0');
 447:         neg := B(B'left) xor A(A'left);
 448:         BA := CONV_SIGNED(('0' & ABS(B)),(A'length+B'length));
 449:         AA := '0' & ABS(A);
 450:         for i in 0 to A'length-1 loop
 451:           if AA(i) = '1' then
 452:             PA := PA+BA;
 453:           end if;
 454:           BA := SHL(BA,one);
 455:         end loop;
 456:         if (neg= '1') then
 457:           return(-PA);
 458:         else 
 459:           return(PA);
 460:         end if;
 461:       end;
 462: 
 463:     function mult(A,B: UNSIGNED) return UNSIGNED is
 464: 
 465:       variable BA: UNSIGNED((A'length+B'length-1) downto 0);
 466:       variable PA: UNSIGNED((A'length+B'length-1) downto 0);
 467:       constant one : UNSIGNED(1 downto 0) := "01";
 468:       
 469:       -- pragma map_to_operator MULT_UNS_OP
 470:       -- pragma type_function MULT_UNSIGNED_ARG
 471:       -- pragma return_port_name Z
 472: 
 473:       begin
 474: 	if (A(A'left) = 'X' or B(B'left) = 'X') then
 475:             PA := (others => 'X');
 476:             return(PA);
 477: 	end if;
 478:         PA := (others => '0');
 479:         BA := CONV_UNSIGNED(B,(A'length+B'length));
 480:         for i in 0 to A'length-1 loop
 481:           if A(i) = '1' then
 482:             PA := PA+BA;
 483:           end if;
 484:           BA := SHL(BA,one);
 485:         end loop;
 486:         return(PA);
 487:       end;
