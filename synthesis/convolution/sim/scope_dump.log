1310: 	-- pragma type_function SIGNED_RETURN_BOOLEAN
1311:         -- pragma return_port_name Z
1312: 
1313:     begin
1314: 	if A(sign) /= B(sign) then
1315: 	    result := A(sign) = '1';
1316: 	else
1317: 	    result := TRUE;
1318: 	    for i in 0 to sign-1 loop
1319: 		a_is_0 := A(i) = '0';
1320: 		b_is_1 := B(i) = '1';
1321: 		result := (a_is_0 and b_is_1) or
1322: 			  (a_is_0 and result) or
1323: 			  (b_is_1 and result);
1324: 	    end loop;
1325: 	end if;
1326: 	return result;
1327:     end;
