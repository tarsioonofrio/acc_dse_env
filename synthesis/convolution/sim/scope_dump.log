1165:   -- Id: A.3
1166:   function "+" (L, R: UNSIGNED) return UNSIGNED is
1167:     constant SIZE: NATURAL := MAX(L'LENGTH, R'LENGTH);
1168:     variable L01 : UNSIGNED(SIZE-1 downto 0);
1169:     variable R01 : UNSIGNED(SIZE-1 downto 0);
1170:   begin
1171:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAU;
1172:     end if;
1173:     L01 := TO_01(RESIZE(L, SIZE), 'X');
1174:     if (L01(L01'LEFT)='X') then return L01;
1175:     end if;
1176:     R01 := TO_01(RESIZE(R, SIZE), 'X');
1177:     if (R01(R01'LEFT)='X') then return R01;
1178:     end if;
1179:     return ADD_UNSIGNED(L01, R01, '0');
1180:   end "+";
