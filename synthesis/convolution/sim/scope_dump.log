1246:     function "ABS"(L: SIGNED) return STD_LOGIC_VECTOR is
1247: 	-- synopsys subpgm_id 294
1248: 	variable tmp: SIGNED(L'length-1 downto 0);
1249:     begin
1250: 	if (L(L'left) = '0' or L(L'left) = 'L') then
1251: 	    return STD_LOGIC_VECTOR (L);
1252: 	else
1253: 	    tmp := 0 - L;
1254: 	    return STD_LOGIC_VECTOR (tmp);
1255: 	end if;
1256:     end;
