1707:     -- for internal use only.  Assumes SIGNED arguments of equal length.
1708:     function bitwise_eql(L: STD_ULOGIC_VECTOR; R: STD_ULOGIC_VECTOR)
1709: 						return BOOLEAN is
1710: 	-- pragma built_in SYN_EQL
1711:     begin
1712: 	for i in L'range loop
1713: 	    if L(i) /= R(i) then
1714: 		return FALSE;
1715: 	    end if;
1716: 	end loop;
1717: 	return TRUE;
1718:     end;
1719: 
1720:     -- for internal use only.  Assumes SIGNED arguments of equal length.
1721:     function bitwise_neq(L: STD_ULOGIC_VECTOR; R: STD_ULOGIC_VECTOR)
1722: 						return BOOLEAN is
1723: 	-- pragma built_in SYN_NEQ
1724:     begin
1725: 	for i in L'range loop
1726: 	    if L(i) /= R(i) then
1727: 		return TRUE;
1728: 	    end if;
1729: 	end loop;
1730: 	return FALSE;
1731:     end;
