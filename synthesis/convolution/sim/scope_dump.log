1641:   -- Id: A.33
1642:   function "mod" (L, R: UNSIGNED) return UNSIGNED is
1643:     constant L_LEFT: INTEGER := L'LENGTH-1;
1644:     constant R_LEFT: INTEGER := R'LENGTH-1;
1645:     alias XXL: UNSIGNED(L_LEFT downto 0) is L;
1646:     alias XXR: UNSIGNED(R_LEFT downto 0) is R;
1647:     variable XL: UNSIGNED(L_LEFT downto 0);
1648:     variable XR: UNSIGNED(R_LEFT downto 0);
1649:     variable FQUOT: UNSIGNED(L'LENGTH-1 downto 0);
1650:     variable FREMAIN: UNSIGNED(R'LENGTH-1 downto 0);
1651:   begin
1652:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAU;
1653:     end if;
1654:     XL := TO_01(XXL, 'X');
1655:     XR := TO_01(XXR, 'X');
1656:     if ((XL(XL'LEFT)='X') or (XR(XR'LEFT)='X')) then
1657:       FREMAIN := (others => 'X');
1658:       return FREMAIN;
1659:     end if;
1660:     DIVMOD(XL, XR, FQUOT, FREMAIN);
1661:     return FREMAIN;
1662:   end "mod";
