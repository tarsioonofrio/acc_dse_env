 50:     
 51: 
 52:   type SEVERITY_LEVEL is (NOTE, WARNING, ERROR, FAILURE);
 53: 
 54:   -- predefined numeric types:
 55: 
 56:   -- Do INTEGER first to aid implicit declarations of "**".
 57:   type INTEGER is range -2147483648 to 2147483647;
 58: -- AVSREQ-142846: As per VHDL LRM 93 section 14.2, LRM 2008 section 16.3, the types universal_integer and universal_real are anonymous types. 
 59: -- They cannot be referred to explicitly and should be defined implicitly in tool. So, commenting here and added implicit definition.
 60: --  type $UNIVERSAL_INTEGER is range $- to $+;
 61: --  type $UNIVERSAL_REAL is range $-. to $+.;
 62: 
 63:   function "*" ($LEFT: $UNIVERSAL_REAL; $RIGHT: $UNIVERSAL_INTEGER)
 64: 	return $UNIVERSAL_REAL;
 65: 
 66:   function "*" ($LEFT: $UNIVERSAL_INTEGER; $RIGHT: $UNIVERSAL_REAL)
 67: 	return $UNIVERSAL_REAL;
 68: 
 69:   function "/" ($LEFT: $UNIVERSAL_REAL; $RIGHT: $UNIVERSAL_INTEGER)
 70: 	return $UNIVERSAL_REAL;
 71: 
 72:   type REAL is range $-. to $+.;
 73: 
 74:   -- predefined type TIME:
 75: 
 76:   type TIME is range $- to $+
 77: 	units
 78: 		fs;			-- femtosecond
 79: 		ps	=  1000 fs;	-- picosecond
 80: 		ns	=  1000 ps;	-- nanosecond
 81: 		us	=  1000 ns;	-- microsecond
 82: 		ms	=  1000 us;	-- millisecond
 83: 		sec	=  1000 ms;	-- second
 84: 		min	=  60 sec;	-- minute
 85: 		hr	=  60 min;	-- hour;
 86:   end units;
 87: 
 88:   -- subtype used internally for checking time expressions for non-negativness:
 89: 
 90:   subtype $NATURAL_TIME is TIME range 0 sec to TIME'HIGH;
 91: 
 92:   subtype DELAY_LENGTH is TIME range 0 fs to TIME'HIGH;
 93: 
 94:   -- function that returns the current simulation time:
 95: 
 96:   impure function  NOW return TIME;
 97: 
 98:   -- predefined numeric subtypes:
 99: 
100:   subtype NATURAL is INTEGER range 0 to INTEGER'HIGH;
101: 
102:   subtype POSITIVE is INTEGER range 1 to INTEGER'HIGH;
103: 
104:   -- predefined array types:
105: 
106:   type STRING is array (POSITIVE range <>) of CHARACTER;
107: 
108:   type BIT_VECTOR is array (NATURAL range <>) of BIT;
109: 
110: --type FILE_OPEN_KIND is (READ_OPEN, WRITE_OPEN, APPEND_OPEN);
111: 
112:   type FILE_OPEN_KIND is (READ_MODE, WRITE_MODE, APPEND_MODE);
113: 
114:   type FILE_OPEN_STATUS is (OPEN_OK, STATUS_ERROR, NAME_ERROR, MODE_ERROR);
115: 
116:   attribute FOREIGN: STRING;
117: 
118:   --
119:   -- The rest of this package is SVEN specific stuff required to make
120:   -- this implementation go.
121:   -- Note that all things are declared use leading $ characters, so we don't
122:   -- trample the user's name space.
123:   --
124: 
125:   attribute $BUILTIN: BOOLEAN;
126: 
127:   procedure $RTINDEX (I: NATURAL; FIRSTARG: INTEGER; PASSAP,SAVEFREGS: BOOLEAN);
128:   procedure $RTSYMBOL (S: STRING; FIRSTARG: INTEGER; PASSAP,SAVEFREGS: BOOLEAN);
129: 
130:   -----------------------------------------------------------------------
131:   --- The following declarations are VHDL AMS specific declarations.  ---
132:   --- These declarations should be ignored in VHDL 87 or VHDL 93 mode ---
133:   -----------------------------------------------------------------------
134:   type DOMAIN_TYPE is (QUIESCENT_DOMAIN, TIME_DOMAIN, FREQUENCY_DOMAIN); --- VHDL AMS
135:   signal DOMAIN : DOMAIN_TYPE := QUIESCENT_DOMAIN;                       --- VHDL AMS
136:   impure function NOW return REAL;                                       --- VHDL AMS
137:   function FREQUENCY return REAL;                                        --- VHDL AMS
138:   type REAL_VECTOR is array (NATURAL range <>) of REAL;                  --- VHDL AMS
139: 
140:   attribute $BUILTIN of all: function is TRUE;
141:   attribute $BUILTIN of all: procedure is TRUE;
142: 
143: end STANDARD;

