2050:   function TO_STRING (VALUE : TIME; UNIT : TIME) return STRING is
2051:     variable L : LINE;  -- pointer
2052:   begin
2053:     deallocate (L);
2054:     write (L => L,
2055:            VALUE => VALUE,
2056:            UNIT => UNIT);
2057:     return L.all;
2058:   end function to_string;
