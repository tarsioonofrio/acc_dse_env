2881:   -- Id: D.1
2882:   function TO_INTEGER (ARG: UNSIGNED) return NATURAL is
2883:     constant ARG_LEFT: INTEGER := ARG'LENGTH-1;
2884:     alias XXARG: UNSIGNED(ARG_LEFT downto 0) is ARG;
2885:     variable XARG: UNSIGNED(ARG_LEFT downto 0);
2886:     variable RESULT: NATURAL := 0;
2887:   begin
2888:     if (ARG'LENGTH < 1) then
2889:       assert NO_WARNING
2890:           report "NUMERIC_STD.TO_INTEGER: null detected, returning 0"
2891:           severity WARNING;
2892:       return 0;
2893:     end if;
2894:     XARG := TO_01(XXARG, 'X');
2895:     if (XARG(XARG'LEFT)='X') then
2896:       assert NO_WARNING
2897:           report "NUMERIC_STD.TO_INTEGER: metavalue detected, returning 0"
2898:           severity WARNING;
2899:       return 0;
2900:     end if;
2901:     for I in XARG'RANGE loop
2902:       RESULT := RESULT+RESULT;
2903:       if XARG(I) = '1' then
2904:         RESULT := RESULT + 1;
2905:       end if;
2906:     end loop;
2907:     return RESULT;
2908:   end TO_INTEGER;
2909: 
2910:   -- Id: D.2
2911:   function TO_INTEGER (ARG: SIGNED) return INTEGER is
2912:     variable XARG: SIGNED(ARG'LENGTH-1 downto 0);
2913:   begin
2914:     if (ARG'LENGTH < 1) then
2915:       assert NO_WARNING
2916:           report "NUMERIC_STD.TO_INTEGER: null detected, returning 0"
2917:           severity WARNING;
2918:       return 0;
2919:     end if;
2920:     XARG := TO_01(ARG, 'X');
2921:     if (XARG(XARG'LEFT)='X') then
2922:       assert NO_WARNING
2923:           report "NUMERIC_STD.TO_INTEGER: metavalue detected, returning 0"
2924:           severity WARNING;
2925:       return 0;
2926:     end if;
2927:     if XARG(XARG'LEFT) = '0' then
2928:       return TO_INTEGER(UNSIGNED(XARG));
2929:     else
2930:       return (- (TO_INTEGER(UNSIGNED(- (XARG + 1)))) -1);
2931:     end if;
2932:   end TO_INTEGER;
