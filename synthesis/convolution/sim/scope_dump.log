1432:   -- Id: A.23
1433:   function "/" (L: UNSIGNED; R: NATURAL) return UNSIGNED is
1434:     constant R_LENGTH: NATURAL := MAX(L'LENGTH, UNSIGNED_NUM_BITS(R));
1435:     variable XR, QUOT: UNSIGNED(R_LENGTH-1 downto 0);
1436:   begin
1437:     if (L'LENGTH < 1) then return NAU;
1438:     end if;
1439:     if (R_LENGTH > L'LENGTH) then
1440:       QUOT := (others => '0');
1441:       return RESIZE(QUOT, L'LENGTH);
1442:     end if;
1443:     XR := TO_UNSIGNED(R, R_LENGTH);
1444:     QUOT := RESIZE((L / XR), QUOT'LENGTH);
1445:     return RESIZE(QUOT, L'LENGTH);
1446:   end "/";
1447: 
1448:   -- Id: A.24
1449:   function "/" (L: NATURAL; R: UNSIGNED) return UNSIGNED is
1450:     constant L_LENGTH: NATURAL := MAX(UNSIGNED_NUM_BITS(L), R'LENGTH);
1451:     variable XL, QUOT: UNSIGNED(L_LENGTH-1 downto 0);
1452:   begin
1453:     if (R'LENGTH < 1) then return NAU;
1454:     end if;
1455:     XL := TO_UNSIGNED(L, L_LENGTH);
1456:     QUOT := RESIZE((XL / R), QUOT'LENGTH);
1457:     if L_LENGTH > R'LENGTH and QUOT(0)/='X'
1458:         and QUOT(L_LENGTH-1 downto R'LENGTH)
1459:         /= (L_LENGTH-1 downto R'LENGTH => '0')
1460:         then
1461:       assert NO_WARNING report "NUMERIC_STD.""/"": Quotient Truncated"
1462:           severity WARNING;
1463:     end if;
1464:     return RESIZE(QUOT, R'LENGTH);
1465:   end "/";
