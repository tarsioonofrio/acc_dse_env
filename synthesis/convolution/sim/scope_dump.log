1290:     alias XXR: UNSIGNED(R_LEFT downto 0) is R;
1291:     variable XL: UNSIGNED(L_LEFT downto 0);
1292:     variable XR: UNSIGNED(R_LEFT downto 0);
1293:     variable RESULT: UNSIGNED((L'LENGTH+R'LENGTH-1) downto 0) :=
1294:         (others => '0');
1295:     variable ADVAL: UNSIGNED((L'LENGTH+R'LENGTH-1) downto 0);
1296:   begin
1297:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAU;
1298:     end if;
1299:     XL := TO_01(XXL, 'X');
1300:     XR := TO_01(XXR, 'X');
1301:     if ((XL(XL'LEFT)='X') or (XR(XR'LEFT)='X')) then
1302:       RESULT := (others => 'X');
1303:       return RESULT;
1304:     end if;
1305:     ADVAL := RESIZE(XR, RESULT'LENGTH);
1306:     for I in 0 to L_LEFT loop
1307:       if XL(I)='1' then RESULT := RESULT + ADVAL;
1308:       end if;
1309:       ADVAL := SHIFT_LEFT(ADVAL, 1);
1310:     end loop;
1311:     return RESULT;
1312:   end "*";
1313: 
1314:   -- Id: A.16
1315:   function "*" (L, R: SIGNED) return SIGNED is
1316:     constant L_LEFT: INTEGER := L'LENGTH-1;
1317:     constant R_LEFT: INTEGER := R'LENGTH-1;
1318:     variable XL: SIGNED(L_LEFT downto 0);
1319:     variable XR: SIGNED(R_LEFT downto 0);
1320:     variable RESULT: SIGNED((L_LEFT+R_LEFT+1) downto 0) := (others => '0');
1321:     variable ADVAL: SIGNED((L_LEFT+R_LEFT+1) downto 0);
1322:   begin
1323:     if ((L_LEFT < 0) or (R_LEFT < 0)) then return NAS;
1324:     end if;
1325:     XL := TO_01(L, 'X');
1326:     XR := TO_01(R, 'X');
1327:     if ((XL(L_LEFT)='X') or (XR(R_LEFT)='X')) then
1328:       RESULT := (others => 'X');
1329:       return RESULT;
1330:     end if;
1331:     ADVAL := RESIZE(XR, RESULT'LENGTH);
1332:     for I in 0 to L_LEFT-1 loop
1333:       if XL(I)='1' then RESULT := RESULT + ADVAL;
1334:       end if;
1335:       ADVAL := SHIFT_LEFT(ADVAL, 1);
1336:     end loop;
1337:     if XL(L_LEFT)='1' then
1338:       RESULT := RESULT - ADVAL;
1339:     end if;
1340:     return RESULT;
1341:   end "*";
