1504:   -- Id: A.27
1505:   function "rem" (L, R: UNSIGNED) return UNSIGNED is
1506:     constant L_LEFT: INTEGER := L'LENGTH-1;
1507:     constant R_LEFT: INTEGER := R'LENGTH-1;
1508:     alias XXL: UNSIGNED(L_LEFT downto 0) is L;
1509:     alias XXR: UNSIGNED(R_LEFT downto 0) is R;
1510:     variable XL: UNSIGNED(L_LEFT downto 0);
1511:     variable XR: UNSIGNED(R_LEFT downto 0);
1512:     variable FQUOT: UNSIGNED(L'LENGTH-1 downto 0);
1513:     variable FREMAIN: UNSIGNED(R'LENGTH-1 downto 0);
1514:   begin
1515:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAU;
1516:     end if;
1517:     XL := TO_01(XXL, 'X');
1518:     XR := TO_01(XXR, 'X');
1519:     if ((XL(XL'LEFT)='X') or (XR(XR'LEFT)='X')) then
1520:       FREMAIN := (others => 'X');
1521:       return FREMAIN;
1522:     end if;
1523:     DIVMOD(XL, XR, FQUOT, FREMAIN);
1524:     return FREMAIN;
1525:   end "rem";
