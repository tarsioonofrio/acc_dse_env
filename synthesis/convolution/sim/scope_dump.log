CHILD_SCOPES(@WORK.util_package)=19: package body util_package is
20: 
21:   --https://nandland.com/file-input-output/
22:   -- https://www.fpga4student.com/2018/08/how-to-read-image-in-vhdl.html
23:   impure function read_data(file_name : in string) return type_array_int is
24:       file file_ptr : text open read_mode is file_name;
25:       variable line_ptr : line;
26:       variable tmp_int : integer := 0;
27:       variable i : integer := 0;
28:       variable tmp_arr : type_array_int := (others=>0);
29:   begin
30:       if file_name = "" then
31:         return tmp_arr;
32:       else
33:         while not endfile(file_ptr) loop
34:         --for i in type_array_int'range loop
35:             readline(file_ptr, line_ptr);
36:             read(line_ptr, tmp_int);
37:             tmp_arr(i) := tmp_int;
38:             i := i + 1;
39:         end loop;
40:         return tmp_arr;
41:       end if;
42:   end function;
43: 
44: 
45: end package body util_package;

