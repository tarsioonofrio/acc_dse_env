1103:     end if;
1104:     for I in 0 to RESULT'LEFT loop
1105:       RESULT(I) := not(XARG(I)) xor CBIT;
1106:       CBIT := CBIT and not(XARG(I));
1107:     end loop;
1108:     return RESULT;
1109:   end "-";
