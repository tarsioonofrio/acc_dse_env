 822:     -------------------------------------------------------------------    
 823:     -- conversion tables
 824:     -------------------------------------------------------------------    
 825:     --synopsys synthesis_off
 826: 
 827:     TYPE logic_x01_table IS ARRAY (std_ulogic'LOW TO std_ulogic'HIGH) OF X01;
 828:     TYPE logic_x01z_table IS ARRAY (std_ulogic'LOW TO std_ulogic'HIGH) OF X01Z;
 829:     TYPE logic_ux01_table IS ARRAY (std_ulogic'LOW TO std_ulogic'HIGH) OF UX01;
 830:     ----------------------------------------------------------
 831:     -- table name : cvt_to_x01
 832:     --
 833:     -- parameters :
 834:     --        in  :  std_ulogic  -- some logic value
 835:     -- returns    :  x01         -- state value of logic value
 836:     -- purpose    :  to convert state-strength to state only
 837:     --                  
 838:     -- example    : if (cvt_to_x01 (input_signal) = '1' ) then ...
 839:     --
 840:     ----------------------------------------------------------
 841:     CONSTANT cvt_to_x01 : logic_x01_table := (
 842:                          'X',  -- 'U'
 843:                          'X',  -- 'X'
 844:                          '0',  -- '0'
 845:                          '1',  -- '1'
 846:                          'X',  -- 'Z'
 847:                          'X',  -- 'W'
 848:                          '0',  -- 'L'
 849:                          '1',  -- 'H'
 850:                          'X'   -- '-'
 851:                         );
 852: 
 853:     ----------------------------------------------------------
 854:     -- table name : cvt_to_x01z
 855:     --
 856:     -- parameters :
 857:     --        in  :  std_ulogic  -- some logic value
 858:     -- returns    :  x01z        -- state value of logic value
 859:     -- purpose    :  to convert state-strength to state only
 860:     --                  
 861:     -- example    : if (cvt_to_x01z (input_signal) = '1' ) then ...
 862:     --
 863:     ----------------------------------------------------------
 864:     CONSTANT cvt_to_x01z : logic_x01z_table := (
 865:                          'X',  -- 'U'
 866:                          'X',  -- 'X'
 867:                          '0',  -- '0'
 868:                          '1',  -- '1'
 869:                          'Z',  -- 'Z'
 870:                          'X',  -- 'W'
 871:                          '0',  -- 'L'
 872:                          '1',  -- 'H'
 873:                          'X'   -- '-'
 874:                         );
 875: 
 876:     ----------------------------------------------------------
 877:     -- table name : cvt_to_ux01
 878:     --
 879:     -- parameters :
 880:     --        in  :  std_ulogic  -- some logic value
 881:     -- returns    :  ux01        -- state value of logic value
 882:     -- purpose    :  to convert state-strength to state only
 883:     --                  
 884:     -- example    : if (cvt_to_ux01 (input_signal) = '1' ) then ...
 885:     --
 886:     ----------------------------------------------------------
 887:     CONSTANT cvt_to_ux01 : logic_ux01_table := (
 888:                          'U',  -- 'U'
 889:                          'X',  -- 'X'
 890:                          '0',  -- '0'
 891:                          '1',  -- '1'
 892:                          'X',  -- 'Z'
 893:                          'X',  -- 'W'
 894:                          '0',  -- 'L'
 895:                          '1',  -- 'H'
 896:                          'X'   -- '-'
 897:                         );
 898:     --synopsys synthesis_on
 899:     
