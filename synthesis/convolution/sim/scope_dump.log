1276:     -- compare two signed numbers of the same length
1277:     -- both arrays must have range (msb downto 0)
1278:     function is_less(A, B: SIGNED) return BOOLEAN is
1279: 	constant sign: INTEGER := A'left;
1280: 	variable a_is_0, b_is_1, result : boolean;
1281: 
1282: 	-- pragma map_to_operator LT_TC_OP
1283: 	-- pragma type_function SIGNED_RETURN_BOOLEAN
1284:         -- pragma return_port_name Z
1285: 
1286:     begin
1287: 	if A(sign) /= B(sign) then
1288: 	    result := A(sign) = '1';
1289: 	else
1290: 	    result := FALSE;
1291: 	    for i in 0 to sign-1 loop
1292: 		a_is_0 := A(i) = '0';
1293: 		b_is_1 := B(i) = '1';
1294: 		result := (a_is_0 and b_is_1) or
1295: 			  (a_is_0 and result) or
1296: 			  (b_is_1 and result);
1297: 	    end loop;
1298: 	end if;
1299: 	return result;
1300:     end;
1301: 
