1211:     function "ABS"(L: SIGNED) return SIGNED is
1212: 	-- synopsys subpgm_id 287
1213:     begin
1214: 	if (L(L'left) = '0' or L(L'left) = 'L') then
1215: 	    return L;
1216: 	else
1217: 	    return 0 - L;
1218: 	end if;
1219:     end;
