1514:       return "";
1515:     else
1516:       for i in ivalue'range loop
1517:         if iValue(i) = '0' then
1518:           result(i) := '0';
1519:         else
1520:           result(i) := '1';
1521:         end if;
1522:       end loop;
1523:       return result;
1524:     end if;
1525:   end function to_string;
