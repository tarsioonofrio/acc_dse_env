1282:     FUNCTION To_UX01  ( b : BIT_VECTOR ) RETURN  std_logic_vector IS
1283:     -- pragma built_in SYN_FEED_THRU
1284:     -- pragma subpgm_id 228
1285:     --synopsys synthesis_off
1286:         ALIAS bv : BIT_VECTOR ( 1 TO b'LENGTH ) IS b;
1287:         VARIABLE result : std_logic_vector ( 1 TO b'LENGTH );
1288:     --synopsys synthesis_on
1289:     BEGIN
1290:     --synopsys synthesis_off
1291:         FOR i IN result'RANGE LOOP
1292:             CASE bv(i) IS
1293:                 WHEN '0' => result(i) := '0';
1294:                 WHEN '1' => result(i) := '1';
1295:             END CASE;
1296:         END LOOP;
1297:         RETURN result;
1298:     --synopsys synthesis_on
1299:     END;
1300:     --------------------------------------------------------------------
1301:     FUNCTION To_UX01  ( b : BIT_VECTOR ) RETURN  std_ulogic_vector IS
1302:     -- pragma built_in SYN_FEED_THRU
1303:     -- pragma subpgm_id 229
1304:     --synopsys synthesis_off
1305:         ALIAS bv : BIT_VECTOR ( 1 TO b'LENGTH ) IS b;
1306:         VARIABLE result : std_ulogic_vector ( 1 TO b'LENGTH );
1307:     --synopsys synthesis_on
1308:     BEGIN
1309:     --synopsys synthesis_off
1310:         FOR i IN result'RANGE LOOP
1311:             CASE bv(i) IS
1312:                 WHEN '0' => result(i) := '0';
1313:                 WHEN '1' => result(i) := '1';
1314:             END CASE;
1315:         END LOOP;
1316:         RETURN result;
1317:     --synopsys synthesis_on
1318:     END;
1319:     --------------------------------------------------------------------
1320:     FUNCTION To_UX01  ( b : BIT ) RETURN  UX01 IS
1321:     -- pragma built_in SYN_FEED_THRU
1322:     -- pragma subpgm_id 230
1323:     BEGIN
1324:     --synopsys synthesis_off
1325:             CASE b IS
1326:                 WHEN '0' => RETURN('0');
1327:                 WHEN '1' => RETURN('1');              
1328:             END CASE;
1329:     --synopsys synthesis_on
1330:     END;
1331: 
1332:     -------------------------------------------------------------------    
1333:     -- edge detection
1334:     -------------------------------------------------------------------    
1335:     --synopsys synthesis_off
1336:     FUNCTION rising_edge  (SIGNAL s : std_ulogic) RETURN BOOLEAN IS
1337:     -- pragma subpgm_id 231
1338:     -- ambit synthesis BUILTIN_RISING_EDGE
1339:     BEGIN
1340:         RETURN (s'EVENT AND (To_X01(s) = '1') AND 
1341:                             (To_X01(s'LAST_VALUE) = '0'));
1342:     END;
1343: 
1344:     FUNCTION falling_edge (SIGNAL s : std_ulogic) RETURN BOOLEAN IS
1345:     -- pragma subpgm_id 232
1346:     -- ambit synthesis BUILTIN_FALLING_EDGE
1347:     BEGIN
1348:         RETURN (s'EVENT AND (To_X01(s) = '0') AND 
1349:                             (To_X01(s'LAST_VALUE) = '1'));
1350:     END;
1351: 
1352:     -------------------------------------------------------------------    
1353:     -- object contains an unknown
1354:     -------------------------------------------------------------------    
1355:     FUNCTION Is_X ( s : std_ulogic_vector ) RETURN  BOOLEAN IS
1356:     -- pragma subpgm_id 233
1357:     BEGIN
1358:         FOR i IN s'RANGE LOOP
1359:             CASE s(i) IS
1360:                 WHEN 'U' | 'X' | 'Z' | 'W' | '-' => RETURN TRUE;
1361:                 WHEN OTHERS => NULL;
1362:             END CASE;
1363:         END LOOP;
1364:         RETURN FALSE;
1365:     END;
1366:     --------------------------------------------------------------------
1367:     FUNCTION Is_X ( s : std_logic_vector  ) RETURN  BOOLEAN IS
1368:     -- pragma subpgm_id 234
1369:     BEGIN
1370:         FOR i IN s'RANGE LOOP
1371:             CASE s(i) IS
1372:                 WHEN 'U' | 'X' | 'Z' | 'W' | '-' => RETURN TRUE;
1373:                 WHEN OTHERS => NULL;
1374:             END CASE;
1375:         END LOOP;
1376:         RETURN FALSE;
1377:     END;
1378:     --------------------------------------------------------------------
1379:     FUNCTION Is_X ( s : std_ulogic        ) RETURN  BOOLEAN IS
1380:     -- pragma subpgm_id 235
1381:     BEGIN
1382:         CASE s IS
1383:             WHEN 'U' | 'X' | 'Z' | 'W' | '-' => RETURN TRUE;
1384:             WHEN OTHERS => NULL;
1385:         END CASE;
1386:         RETURN FALSE;
1387:     END;
1388:     --synopsys synthesis_on
1389: 
1390: END std_logic_1164;

CHILD_SCOPES(:)= 45: architecture a1 of tb is
 46:   signal clock, reset, start_conv, debug : std_logic := '0';
 47: 
 48:   signal ofmap_valid, ofmap_ce, ofmap_we, iwght_ce, iwght_valid, ifmap_ce, ifmap_valid, end_conv : std_logic := '0';
 49: 
 50:   signal iwght_address, ifmap_address, ofmap_address : std_logic_vector(MEM_SIZE-1 downto 0);
 51: 
 52:   signal iwght_value, ifmap_value : std_logic_vector((INPUT_SIZE*2)-1 downto 0);
 53: 
 54:   signal ofmap_out, ofmap_in : std_logic_vector(((INPUT_SIZE*2)+CARRY_SIZE)-1 downto 0);
 55: 
 56:   signal iwght_n_read, iwght_n_write, ifmap_n_read, ifmap_n_write, ofmap_n_read, ofmap_n_write : std_logic_vector(31 downto 0);
 57: 
 58:   file sim_file : text open write_mode is "sim.txt";
 59:   file sim_report : text open write_mode is "rtl_split_synth_report.txt";
 60:   signal gold : type_array_int := read_data(PATH & "/s_default_quant.txt");
 61:   --signal gold : type_array_int := read_data(PATH & "/s.txt");
 62:   --signal gold : type_array_int := read_data(PATH & "/gold.txt");
 63: 
 64:   -- Bind directly to the gate-level Verilog module "convolution".
 65:   component convolution is
 66:     port (clock : in std_logic;
 67:           reset : in std_logic;
 68:           start_conv : in std_logic;
 69:           end_conv   : out std_logic;
 70:           debug      : out std_logic;
 71: 
 72:           iwght_valid   : in  std_logic;
 73:           iwght_value   : in  std_logic_vector((INPUT_SIZE*2)-1 downto 0);
 74:           iwght_address : out std_logic_vector(MEM_SIZE-1 downto 0);
 75:           iwght_ce      : out std_logic;
 76: 
 77:           ifmap_valid   : in  std_logic;
 78:           ifmap_value   : in  std_logic_vector((INPUT_SIZE*2)-1 downto 0);
 79:           ifmap_address : out std_logic_vector(MEM_SIZE-1 downto 0);
 80:           ifmap_ce      : out std_logic;
 81: 
 82:           ofmap_valid   : in  std_logic;
 83:           ofmap_in      : in  std_logic_vector(((INPUT_SIZE*2)+CARRY_SIZE)-1 downto 0);
 84:           ofmap_out     : out std_logic_vector(((INPUT_SIZE*2)+CARRY_SIZE)-1 downto 0);
 85:           ofmap_address : out std_logic_vector(MEM_SIZE-1 downto 0);
 86:           ofmap_we      : out std_logic;
 87:           ofmap_ce      : out std_logic
 88:           );
 89:   end component;
 90: 
 91: begin
 92: 
 93:   IWGHT : entity work.memory
 94:     generic map(
 95:       ROM_PATH => PATH & "/g.txt",
 96:       --ROM_PATH => PATH & "/iwght.txt",
 97:       INPUT_SIZE => INPUT_SIZE*2,
 98:       ADDRESS_SIZE => MEM_SIZE,
 99:       DATA_AV_LATENCY => LAT
100:       )
101:     port map(
102:       clock    => clock,
103:       reset    => reset,
104:       chip_en  => iwght_ce,
105:       wr_en    => '0',
106:       data_in  => (others => '0'),
107:       address  => iwght_address,
108:       data_av  => iwght_valid,
109:       data_out => iwght_value,
110:       n_read   => iwght_n_read,
111:       n_write  => iwght_n_write
112:       );
113: 
114:   IFMAP : entity work.memory
115:     generic map(
116:       ROM_PATH => PATH & "/d.txt",
117:       --ROM_PATH => PATH & "/ifmap.txt",
118:       INPUT_SIZE => INPUT_SIZE*2,
119:       ADDRESS_SIZE => MEM_SIZE,
120:       DATA_AV_LATENCY => LAT
121:       )
122:     port map(
123:       clock    => clock,
124:       reset    => reset,
125:       chip_en  => ifmap_ce,
126:       wr_en    => '0',
127:       data_in  => (others => '0'),
128:       address  => ifmap_address,
129:       data_av  => ifmap_valid,
130:       data_out => ifmap_value,
131:       n_read   => ifmap_n_read,
132:       n_write  => ifmap_n_write
133:       );
134: 
135:   OFMAP : entity work.memory
136:     generic map(
137:       --ROM_PATH => "no",
138:       INPUT_SIZE => ((INPUT_SIZE*2)+CARRY_SIZE),
139:       ADDRESS_SIZE => MEM_SIZE,
140:       DATA_AV_LATENCY => LAT
141:       )
142:     port map(
143:       clock    => clock,
144:       reset    => reset,
145:       chip_en  => ofmap_ce,
146:       wr_en    => ofmap_we,
147:       data_in  => ofmap_out,
148:       address  => ofmap_address,
149:       data_av  => ofmap_valid,
150:       data_out => ofmap_in,
151:       n_read   => ofmap_n_read,
152:       n_write  => ofmap_n_write
153:       );
154: 
155:   dut : convolution
156:     port map(
157:       clock         => clock,
158:       reset         => reset,
159: 
160:       start_conv    => start_conv,
161:       end_conv      => end_conv,
162:       debug         => debug,
163: 
164:       iwght_valid   => iwght_valid,
165:       iwght_value   => iwght_value,
166:       iwght_address => iwght_address,
167:       iwght_ce      => iwght_ce,
168: 
169:       ifmap_valid   => ifmap_valid,
170:       ifmap_value   => ifmap_value,
171:       ifmap_address => ifmap_address,
172:       ifmap_ce      => ifmap_ce,
173: 
174:       ofmap_valid   => ofmap_valid,
175:       ofmap_in      => ofmap_in,
176:       ofmap_out     => ofmap_out,
177:       ofmap_address => ofmap_address,
178:       ofmap_we      => ofmap_we,
179:       ofmap_ce      => ofmap_ce
180:       );
181: 
182:   --clock <= not clock after CLK_HALF;
183:   --reset <= '1', '0' after RST_TIME;
184:   --start_conv <= '0', '1' after RST_TIME, '0' after RST_TIME + CLK_HALF;
185: 
186:   clock <= not clock after 5 ns;
187:   reset <= '1', '0' after 10 ns;
188:   start_conv <= '0', '1' after 15 ns, '0' after 25 ns;
189: 
190: 
191:   process(clock)
192: 
193:     -- convolution counter
194:   variable cont_conv           : integer := 0;
195:   variable expected_int        : integer := 0;
196:   variable out_line            : line;
197:   variable sim_start           : time := 0 ns;
198:   variable elapsed             : time;
199:   variable total_cycles        : integer := 0;
200:   variable iwght_active_cycles : integer := 0;
201:   variable ifmap_active_cycles : integer := 0;
202:   variable ofmap_active_cycles : integer := 0;
203:   variable counting            : boolean := false;
204: 
205:   begin
206: 
207:     if clock'event and clock = '0' then
208:       if start_conv = '1' then
209:         sim_start := now;
210:         counting  := true;
211:       end if;
212: 
213:       if counting then
214:         total_cycles := total_cycles + 1;
215:         if iwght_ce = '1' then
216:           iwght_active_cycles := iwght_active_cycles + 1;
217:         end if;
218:         if ifmap_ce = '1' then
219:           ifmap_active_cycles := ifmap_active_cycles + 1;
220:         end if;
221:         if ofmap_ce = '1' then
222:           ofmap_active_cycles := ofmap_active_cycles + 1;
223:         end if;
224:       end if;
225: 
226:       if debug = '1' and cont_conv < TOTAL_OPS then
227:         expected_int := gold(CONV_INTEGER(unsigned(ofmap_address)));
228:         if expected_int < 0 then
229:           expected_int := 0;
230:         end if;
231:         if SHIFT > 0 then
232:           expected_int := expected_int / (2**SHIFT);
233:         end if;
234:         if ofmap_out /= CONV_STD_LOGIC_VECTOR(expected_int, ((INPUT_SIZE*2)+CARRY_SIZE)) then
235:           report "end of simulation with error!";
236:           report "number of convolutions executed: " & integer'image(cont_conv);
237:           report "idx: " & integer'image(CONV_INTEGER(unsigned(ofmap_address)));
238:           report "expected value: " & integer'image(expected_int);
239: 
240:           if (INPUT_SIZE*2)+CARRY_SIZE > 32 then
241:             report "obtained value: " & integer'image(CONV_INTEGER(ofmap_out(31 downto 0)));
242:           else
243:             report "obtained value: " & integer'image(CONV_INTEGER(ofmap_out));
244:           end if;
245: 
246:           assert false severity failure;
247:         end if;
248:         cont_conv := cont_conv + 1;
249: 
250:       elsif end_conv = '1' then
251:         counting := false;
252:         report "number of iwght read: " & integer'image(CONV_INTEGER(unsigned(iwght_n_read)));
253:         report "number of iwght write: " & integer'image(CONV_INTEGER(unsigned(iwght_n_write)));
254:         report "number of ifmap read: " & integer'image(CONV_INTEGER(unsigned(ifmap_n_read)));
255:         report "number of ifmap write: " & integer'image(CONV_INTEGER(unsigned(ifmap_n_write)));
256:         report "number of ofmap read: " & integer'image(CONV_INTEGER(unsigned(ofmap_n_read)));
257:         report "number of ofmap write: " & integer'image(CONV_INTEGER(unsigned(ofmap_n_write)));
258:         report "number of convolutions: " & integer'image(cont_conv);
259: 
260:         elapsed := now - sim_start;
261:         write(out_line, string'("runtime="));
262:         write(out_line, elapsed);
263:         writeline(sim_file, out_line);
264: 
265:         write(out_line, string'("total_cycles="));
266:         write(out_line, integer'image(total_cycles));
267:         writeline(sim_file, out_line);
268: 
269:         write(out_line, string'("total_cycles: "));
270:         write(out_line, total_cycles);
271:         write(out_line, string'(", exec_time: "));
272:         write(out_line, elapsed);
273:         writeline(sim_report, out_line);
274: 
275:         write(out_line, string'("iwght_active_cycles="));
276:         write(out_line, integer'image(iwght_active_cycles));
277:         writeline(sim_file, out_line);
278: 
279:         write(out_line, string'("ifmap_active_cycles="));
280:         write(out_line, integer'image(ifmap_active_cycles));
281:         writeline(sim_file, out_line);
282: 
283:         write(out_line, string'("ofmap_active_cycles="));
284:         write(out_line, integer'image(ofmap_active_cycles));
285:         writeline(sim_file, out_line);
286: 
287:         report "total_cycles=" & integer'image(total_cycles);
288:         report "iwght_active_cycles=" & integer'image(iwght_active_cycles);
289:         report "ifmap_active_cycles=" & integer'image(ifmap_active_cycles);
290:         report "ofmap_active_cycles=" & integer'image(ofmap_active_cycles);
291: 
292:         report "end of simulation without error!" severity failure;
293:       end if;
294:     end if;
295: 
296:   end process;
297: 
298: end a1;

