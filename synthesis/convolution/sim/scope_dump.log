1618:   function "<" (L, R : INTEGER_VECTOR) return BOOLEAN is
1619:   begin
1620:     if L'length /= R'length then
1621:       return L'length < R'length;
1622:     else
1623:       for i in l'range loop
1624:         if L(i) /= R(i) then
1625:           if L(i) < R(i) then
1626:             return true;
1627:           else
1628:             return false;
1629:           end if;
1630:         end if;
1631:       end loop;
1632:       return false;
1633:     end if;
1634:   end function "<";
