1530:   function TO_OSTRING (VALUE : BIT_VECTOR) return STRING is
1531:     constant ne : INTEGER := (value'length+2)/3;
1532:     constant pad : BIT_VECTOR(0 to (ne*3 - value'length) - 1) := (others => '0');
1533:     variable ivalue : BIT_VECTOR(0 to ne*3 - 1);
1534:     variable result : STRING(1 to ne);
1535:     variable tri : BIT_VECTOR(0 to 2);
1536:   begin
1537:     if value'length < 1 then
1538:       return "";
1539:     end if;
1540:     ivalue := pad & value;
1541:     for i in 0 to ne-1 loop
1542:       tri := ivalue(3*i to 3*i+2);
1543:       case tri is
1544:         when o"0" => result(i+1) := '0';
1545:         when o"1" => result(i+1) := '1';
1546:         when o"2" => result(i+1) := '2';
1547:         when o"3" => result(i+1) := '3';
1548:         when o"4" => result(i+1) := '4';
1549:         when o"5" => result(i+1) := '5';
1550:         when o"6" => result(i+1) := '6';
1551:         when o"7" => result(i+1) := '7';
1552:       end case;
1553:     end loop;
1554:     return result;
1555:   end function to_ostring;
1556: --  alias TO_OCTAL_STRING is TO_OSTRING [BIT_VECTOR return STRING];
