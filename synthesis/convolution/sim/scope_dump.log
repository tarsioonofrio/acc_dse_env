2986:   -- Id: R.1
2987:   function RESIZE (ARG: SIGNED; NEW_SIZE: NATURAL) return SIGNED is
2988:     alias INVEC: SIGNED(ARG'LENGTH-1 downto 0) is ARG;
2989:     variable RESULT: SIGNED(NEW_SIZE-1 downto 0) := (others => '0');
2990:     constant BOUND: INTEGER := MIN(ARG'LENGTH, RESULT'LENGTH)-2;
2991:   begin
2992:     if (NEW_SIZE < 1) then return NAS;
2993:     end if;
2994:     if (ARG'LENGTH = 0) then return RESULT;
2995:     end if;
2996:     RESULT := (others => ARG(ARG'LEFT));
2997:     if BOUND >= 0 then
2998:       RESULT(BOUND downto 0) := INVEC(BOUND downto 0);
2999:     end if;
3000:     return RESULT;
3001:   end RESIZE;
3002: 
3003:   -- Id: R.2
3004:   function RESIZE (ARG: UNSIGNED; NEW_SIZE: NATURAL) return UNSIGNED is
3005:     constant ARG_LEFT: INTEGER := ARG'LENGTH-1;
3006:     alias XARG: UNSIGNED(ARG_LEFT downto 0) is ARG;
3007:     variable RESULT: UNSIGNED(NEW_SIZE-1 downto 0) := (others => '0');
3008:   begin
3009:     if (NEW_SIZE < 1) then return NAU;
3010:     end if;
3011:     if XARG'LENGTH =0 then return RESULT;
3012:     end if;
3013:     if (RESULT'LENGTH < ARG'LENGTH) then
3014:       RESULT(RESULT'LEFT downto 0) := XARG(RESULT'LEFT downto 0);
3015:     else
3016:       RESULT(RESULT'LEFT downto XARG'LEFT+1) := (others => '0');
3017:       RESULT(XARG'LEFT downto 0) := XARG;
3018:     end if;
3019:     return RESULT;
3020:   end RESIZE;
