3172:   -- Id: M.2
3173:   function STD_MATCH (L, R: UNSIGNED) return BOOLEAN is
3174:     alias LV: UNSIGNED(1 to L'LENGTH) is L;
3175:     alias RV: UNSIGNED(1 to R'LENGTH) is R;
3176:   begin
3177:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then
3178:       assert NO_WARNING
3179:           report "NUMERIC_STD.STD_MATCH: null detected, returning FALSE"
3180:           severity WARNING;
3181:       return FALSE;
3182:     end if;
3183:     if LV'LENGTH /= RV'LENGTH then
3184:       assert NO_WARNING
3185:           report "NUMERIC_STD.STD_MATCH: L'LENGTH /= R'LENGTH, returning FALSE"
3186:           severity WARNING;
3187:       return FALSE;
3188:     else
3189:       for I in LV'LOW to LV'HIGH loop
3190:         if not (MATCH_TABLE(LV(I), RV(I))) then
3191:           return FALSE;
3192:         end if;
3193:       end loop;
3194:       return TRUE;
3195:     end if;
3196:   end STD_MATCH;
