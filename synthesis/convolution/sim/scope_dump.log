1558:   function TO_HSTRING (VALUE : BIT_VECTOR) return STRING is
1559:     constant ne : INTEGER := (value'length+3)/4;
1560:     constant pad : BIT_VECTOR(0 to (ne*4 - value'length) - 1) := (others => '0');
1561:     variable ivalue : BIT_VECTOR(0 to ne*4 - 1);
1562:     variable result : STRING(1 to ne);
1563:     variable quad : BIT_VECTOR(0 to 3);
1564:   begin
1565:     if value'length < 1 then
1566:       return "";
1567:     end if;
1568:     ivalue := pad & value;
1569:     for i in 0 to ne-1 loop
1570:       quad := ivalue(4*i to 4*i+3);
1571:       case quad is
1572:         when x"0" => result(i+1) := '0';
1573:         when x"1" => result(i+1) := '1';
1574:         when x"2" => result(i+1) := '2';
1575:         when x"3" => result(i+1) := '3';
1576:         when x"4" => result(i+1) := '4';
1577:         when x"5" => result(i+1) := '5';
