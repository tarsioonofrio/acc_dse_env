 489:     -- subtract two signed numbers of the same length
 490:     -- both arrays must have range (msb downto 0)
 491:     function minus(A, B: SIGNED) return SIGNED is
 492: 	variable carry: STD_ULOGIC;
 493: 	variable BV: STD_ULOGIC_VECTOR (A'left downto 0);
 494: 	variable sum: SIGNED (A'left downto 0);
 495: 
 496: 	-- pragma map_to_operator SUB_TC_OP
 497: 
 498: 	-- pragma type_function LEFT_SIGNED_ARG
 499:         -- pragma return_port_name Z
 500: 
 501:     begin
 502: 	if (A(A'left) = 'X' or B(B'left) = 'X') then
 503:             sum := (others => 'X');
 504:             return(sum);
 505: 	end if;
 506: 	carry := '1';
 507: 	BV := not STD_ULOGIC_VECTOR(B);
 508: 
 509: 	for i in 0 to A'left loop
 510: 	    sum(i) := A(i) xor BV(i) xor carry;
 511: 	    carry := (A(i) and BV(i)) or
 512: 		    (A(i) and carry) or
 513: 		    (carry and BV(i));
 514: 	end loop;
 515: 	return sum;
 516:     end;
 517: 
 518:     -- add two signed numbers of the same length
 519:     -- both arrays must have range (msb downto 0)
 520:     function plus(A, B: SIGNED) return SIGNED is
 521: 	variable carry: STD_ULOGIC;
 522: 	variable BV, sum: SIGNED (A'left downto 0);
 523: 
 524: 	-- pragma map_to_operator ADD_TC_OP
 525: 	-- pragma type_function LEFT_SIGNED_ARG
 526:         -- pragma return_port_name Z
 527: 
 528:     begin
 529: 	if (A(A'left) = 'X' or B(B'left) = 'X') then
 530:             sum := (others => 'X');
 531:             return(sum);
 532: 	end if;
 533: 	carry := '0';
 534: 	BV := B;
 535: 
 536: 	for i in 0 to A'left loop
 537: 	    sum(i) := A(i) xor BV(i) xor carry;
 538: 	    carry := (A(i) and BV(i)) or
 539: 		    (A(i) and carry) or
 540: 		    (carry and BV(i));
 541: 	end loop;
 542: 	return sum;
 543:     end;
