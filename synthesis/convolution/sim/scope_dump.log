3278:   -- function TO_01 is used to convert vectors to the
3279:   --          correct form for exported functions,
3280:   --          and to report if there is an element which
3281:   --          is not in (0, 1, H, L).
3282: 
3283:   -- Id: T.1
3284:   function TO_01 (S: UNSIGNED; XMAP: STD_LOGIC := '0') return UNSIGNED is
3285:     variable RESULT: UNSIGNED(S'LENGTH-1 downto 0);
3286:     variable BAD_ELEMENT: BOOLEAN := FALSE;
3287:     alias XS: UNSIGNED(S'LENGTH-1 downto 0) is S;
3288:   begin
3289:     if (S'LENGTH < 1) then
3290:       assert NO_WARNING
3291:           report "NUMERIC_STD.TO_01: null detected, returning NAU"
3292:           severity WARNING;
3293:       return NAU;
3294:     end if;
3295:     for I in RESULT'RANGE loop
3296:       case XS(I) is
3297:         when '0' | 'L' => RESULT(I) := '0';
3298:         when '1' | 'H' => RESULT(I) := '1';
3299:         when others => BAD_ELEMENT := TRUE;
3300:       end case;
3301:     end loop;
3302:     if BAD_ELEMENT then
3303:       for I in RESULT'RANGE loop
3304:         RESULT(I) := XMAP; -- standard fixup
3305:       end loop;
3306:     end if;
3307:     return RESULT;
3308:   end TO_01;
3309: 
3310:   -- Id: T.2
3311:   function TO_01 (S: SIGNED; XMAP: STD_LOGIC := '0') return SIGNED is
3312:     variable RESULT: SIGNED(S'LENGTH-1 downto 0);
3313:     variable BAD_ELEMENT: BOOLEAN := FALSE;
3314:     alias XS: SIGNED(S'LENGTH-1 downto 0) is S;
3315:   begin
3316:     if (S'LENGTH < 1) then
3317:       assert NO_WARNING
3318:           report "NUMERIC_STD.TO_01: null detected, returning NAS"
3319:           severity WARNING;
3320:       return NAS;
3321:     end if;
3322:     for I in RESULT'RANGE loop
3323:       case XS(I) is
3324:         when '0' | 'L' => RESULT(I) := '0';
3325:         when '1' | 'H' => RESULT(I) := '1';
3326:         when others => BAD_ELEMENT := TRUE;
3327:       end case;
3328:     end loop;
3329:     if BAD_ELEMENT then
3330:       for I in RESULT'RANGE loop
3331:         RESULT(I) := XMAP; -- standard fixup
3332:       end loop;
3333:     end if;
3334:     return RESULT;
3335:   end TO_01;
