1664:   -- Id: A.34
1665:   function "mod" (L, R: SIGNED) return SIGNED is
1666:     constant L_LEFT: INTEGER := L'LENGTH-1;
1667:     constant R_LEFT: INTEGER := R'LENGTH-1;
1668:     alias XXL: SIGNED(L_LEFT downto 0) is L;
1669:     alias XXR: SIGNED(R_LEFT downto 0) is R;
1670:     variable XL: SIGNED(L_LEFT downto 0);
1671:     variable XR: SIGNED(R_LEFT downto 0);
1672:     variable FQUOT: UNSIGNED(L'LENGTH-1 downto 0);
1673:     variable FREMAIN: UNSIGNED(R'LENGTH-1 downto 0);
1674:     variable XNUM: UNSIGNED(L'LENGTH-1 downto 0);
1675:     variable XDENOM: UNSIGNED(R'LENGTH-1 downto 0);
1676:     variable RNEG: BOOLEAN := FALSE;
1677:   begin
1678:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAS;
1679:     end if;
1680:     XL := TO_01(XXL, 'X');
1681:     XR := TO_01(XXR, 'X');
1682:     if ((XL(XL'LEFT)='X') or (XR(XR'LEFT)='X')) then
1683:       FREMAIN := (others => 'X');
1684:       return SIGNED(FREMAIN);
1685:     end if;
1686:     if XL(XL'LEFT)='1' then
1687:       XNUM := UNSIGNED(-XL);
1688:     else
1689:       XNUM := UNSIGNED(XL);
1690:     end if;
1691:     if XR(XR'LEFT)='1' then
1692:       XDENOM := UNSIGNED(-XR);
1693:       RNEG := TRUE;
1694:     else
1695:       XDENOM := UNSIGNED(XR);
1696:     end if;
1697:     DIVMOD(XNUM, XDENOM, FQUOT, FREMAIN);
1698:     if RNEG and L(L'LEFT)='1' then
1699:       FREMAIN := "0"-FREMAIN;
1700:     elsif RNEG and FREMAIN/="0" then
1701:       FREMAIN := FREMAIN-XDENOM;
1702:     elsif L(L'LEFT)='1' and FREMAIN/="0" then
1703:       FREMAIN := XDENOM-FREMAIN;
1704:     end if;
1705:     return SIGNED(FREMAIN);
1706:   end "mod";
