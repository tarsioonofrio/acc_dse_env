1527:   -- Id: A.28
1528:   function "rem" (L, R: SIGNED) return SIGNED is
1529:     constant L_LEFT: INTEGER := L'LENGTH-1;
1530:     constant R_LEFT: INTEGER := R'LENGTH-1;
1531:     alias XXL: SIGNED(L_LEFT downto 0) is L;
1532:     alias XXR: SIGNED(R_LEFT downto 0) is R;
1533:     variable FQUOT: UNSIGNED(L'LENGTH-1 downto 0);
1534:     variable FREMAIN: UNSIGNED(R'LENGTH-1 downto 0);
1535:     variable XNUM: UNSIGNED(L'LENGTH-1 downto 0);
1536:     variable XDENOM: UNSIGNED(R'LENGTH-1 downto 0);
1537:     variable RNEG: BOOLEAN := FALSE;
1538:   begin
1539:     if ((L'LENGTH < 1) or (R'LENGTH < 1)) then return NAS;
1540:     end if;
1541:     XNUM := UNSIGNED(TO_01(XXL, 'X'));
1542:     XDENOM := UNSIGNED(TO_01(XXR, 'X'));
1543:     if ((XNUM(XNUM'LEFT)='X') or (XDENOM(XDENOM'LEFT)='X')) then
1544:       FREMAIN := (others => 'X');
1545:       return SIGNED(FREMAIN);
1546:     end if;
1547:     if XNUM(XNUM'LEFT)='1' then
1548:       XNUM := UNSIGNED(-SIGNED(XNUM));
1549:       RNEG := TRUE;
1550:     else
1551:       XNUM := UNSIGNED(XNUM);
1552:     end if;
1553:     if XDENOM(XDENOM'LEFT)='1' then
1554:       XDENOM := UNSIGNED(-SIGNED(XDENOM));
1555:     else
1556:       XDENOM := UNSIGNED(XDENOM);
1557:     end if;
1558:     DIVMOD(XNUM, XDENOM, FQUOT, FREMAIN);
1559:     if RNEG then
1560:       FREMAIN := "0"-FREMAIN;
1561:     end if;
1562:     return SIGNED(FREMAIN);
1563:   end "rem";
