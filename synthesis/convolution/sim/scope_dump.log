CHILD_SCOPES(@IEEE.NUMERIC_STD)= 859: package body NUMERIC_STD is
 860: 
 861:   -- null range array constants
 862: 
 863:   constant NAU: UNSIGNED(0 downto 1) := (others => '0');
 864:   constant NAS: SIGNED(0 downto 1) := (others => '0');
 865: 
 866:   -- implementation controls
 867: 
 868:   constant NO_WARNING: BOOLEAN := FALSE; -- default to emit warnings
 869: 
 870:   --=========================Local Subprograms =================================
 871: 
 872:   function MAX (LEFT, RIGHT: INTEGER) return INTEGER is
 873:   begin
 874:     if LEFT > RIGHT then return LEFT;
 875:     else return RIGHT;
 876:     end if;
 877:   end MAX;
 878: 
 879:   function MIN (LEFT, RIGHT: INTEGER) return INTEGER is
 880:   begin
 881:     if LEFT < RIGHT then return LEFT;
 882:     else return RIGHT;
 883:     end if;
 884:   end MIN;
 885: 
 886:   function SIGNED_NUM_BITS (ARG: INTEGER) return NATURAL is
 887:     variable NBITS: NATURAL;
 888:     variable N: NATURAL;
 889:   begin
 890:     if ARG >= 0 then
 891:       N := ARG;
 892:     else
 893:       N := -(ARG+1);
 894:     end if;
 895:     NBITS := 1;
 896:     while N > 0 loop
 897:       NBITS := NBITS+1;
 898:       N := N / 2;
 899:     end loop;
 900:     return NBITS;
 901:   end SIGNED_NUM_BITS;
 902: 
 903:   function UNSIGNED_NUM_BITS (ARG: NATURAL) return NATURAL is
 904:     variable NBITS: NATURAL;
 905:     variable N: NATURAL;
 906:   begin
 907:     N := ARG;
 908:     NBITS := 1;
 909:     while N > 1 loop
 910:       NBITS := NBITS+1;
 911:       N := N / 2;
 912:     end loop;
 913:     return NBITS;
 914:   end UNSIGNED_NUM_BITS;
 915: 
 916:   ------------------------------------------------------------------------
 917: 
 918:   -- this internal function computes the addition of two UNSIGNED
 919:   -- with input CARRY
 920:   -- * the two arguments are of the same length
 921: 
 922:   function ADD_UNSIGNED (L, R: UNSIGNED; C: STD_LOGIC) return UNSIGNED is
 923:     constant L_LEFT: INTEGER := L'LENGTH-1;
 924:     alias XL: UNSIGNED(L_LEFT downto 0) is L;
 925:     alias XR: UNSIGNED(L_LEFT downto 0) is R;
 926:     variable RESULT: UNSIGNED(L_LEFT downto 0);
 927:     variable CBIT: STD_LOGIC := C;
 928:   begin
 929:     for I in 0 to L_LEFT loop
 930:       RESULT(I) := CBIT xor XL(I) xor XR(I);
 931:       CBIT := (CBIT and XL(I)) or (CBIT and XR(I)) or (XL(I) and XR(I));
 932:     end loop;
 933:     return RESULT;
 934:   end ADD_UNSIGNED;
 935: 
 936:   -- this internal function computes the addition of two SIGNED
 937:   -- with input CARRY
 938:   -- * the two arguments are of the same length
 939: 
 940:   function ADD_SIGNED (L, R: SIGNED; C: STD_LOGIC) return SIGNED is
 941:     constant L_LEFT: INTEGER := L'LENGTH-1;
 942:     alias XL: SIGNED(L_LEFT downto 0) is L;
 943:     alias XR: SIGNED(L_LEFT downto 0) is R;
 944:     variable RESULT: SIGNED(L_LEFT downto 0);
 945:     variable CBIT: STD_LOGIC := C;
 946:   begin
 947:     for I in 0 to L_LEFT loop
 948:       RESULT(I) := CBIT xor XL(I) xor XR(I);
 949:       CBIT := (CBIT and XL(I)) or (CBIT and XR(I)) or (XL(I) and XR(I));
 950:     end loop;
 951:     return RESULT;
 952:   end ADD_SIGNED;
 953: 
 954:   -----------------------------------------------------------------------------
 955: 
 956:   -- this internal procedure computes UNSIGNED division
 957:   -- giving the quotient and remainder.
 958:   procedure DIVMOD (NUM, XDENOM: UNSIGNED; XQUOT, XREMAIN: out UNSIGNED) is
 959:     variable TEMP: UNSIGNED(NUM'LENGTH downto 0);
 960:     variable QUOT: UNSIGNED(MAX(NUM'LENGTH, XDENOM'LENGTH)-1 downto 0);
 961:     alias DENOM: UNSIGNED(XDENOM'LENGTH-1 downto 0) is XDENOM;
 962:     variable TOPBIT: INTEGER;
 963:   begin
 964:     TEMP := "0"&NUM;
 965:     QUOT := (others => '0');
 966:     TOPBIT := -1;
 967:     for J in DENOM'RANGE loop
 968:       if DENOM(J)='1' then
 969:         TOPBIT := J;
 970:         exit;
 971:       end if;
 972:     end loop;
 973:     assert TOPBIT >= 0 report "DIV, MOD, or REM by zero" severity ERROR;
 974: 
 975:     for J in NUM'LENGTH-(TOPBIT+1) downto 0 loop
 976:       if TEMP(TOPBIT+J+1 downto J) >= "0"&DENOM(TOPBIT downto 0) then
 977:         TEMP(TOPBIT+J+1 downto J) := (TEMP(TOPBIT+J+1 downto J))
 978:             -("0"&DENOM(TOPBIT downto 0));
 979:         QUOT(J) := '1';
 980:       end if;
 981:       assert TEMP(TOPBIT+J+1)='0'
 982:           report "internal error in the division algorithm"
 983:           severity ERROR;
 984:     end loop;
 985:     XQUOT := RESIZE(QUOT, XQUOT'LENGTH);
 986:     XREMAIN := RESIZE(TEMP, XREMAIN'LENGTH);
 987:   end DIVMOD;
 988: 
 989:   -----------------Local Subprograms - shift/rotate ops-------------------------
 990: 
 991:   function XSLL (ARG: STD_LOGIC_VECTOR; COUNT: NATURAL) return STD_LOGIC_VECTOR
 992:       is
 993:     constant ARG_L: INTEGER := ARG'LENGTH-1;
 994:     alias XARG: STD_LOGIC_VECTOR(ARG_L downto 0) is ARG;
 995:     variable RESULT: STD_LOGIC_VECTOR(ARG_L downto 0) := (others => '0');
 996:   begin
 997:     if COUNT <= ARG_L then
 998:       RESULT(ARG_L downto COUNT) := XARG(ARG_L-COUNT downto 0);
 999:     end if;
1000:     return RESULT;
1001:   end XSLL;
1002: 
1003:   function XSRL (ARG: STD_LOGIC_VECTOR; COUNT: NATURAL) return STD_LOGIC_VECTOR
1004:       is
1005:     constant ARG_L: INTEGER := ARG'LENGTH-1;
1006:     alias XARG: STD_LOGIC_VECTOR(ARG_L downto 0) is ARG;
1007:     variable RESULT: STD_LOGIC_VECTOR(ARG_L downto 0) := (others => '0');
1008:   begin
1009:     if COUNT <= ARG_L then
1010:       RESULT(ARG_L-COUNT downto 0) := XARG(ARG_L downto COUNT);
1011:     end if;
1012:     return RESULT;
1013:   end XSRL;
1014: 
1015:   function XSRA (ARG: STD_LOGIC_VECTOR; COUNT: NATURAL) return STD_LOGIC_VECTOR
1016:       is
1017:     constant ARG_L: INTEGER := ARG'LENGTH-1;
1018:     alias XARG: STD_LOGIC_VECTOR(ARG_L downto 0) is ARG;
1019:     variable RESULT: STD_LOGIC_VECTOR(ARG_L downto 0);
1020:     variable XCOUNT: NATURAL := COUNT;
1021:   begin
1022:     if ((ARG'LENGTH <= 1) or (XCOUNT = 0)) then return ARG;
1023:     else
1024:       if (XCOUNT > ARG_L) then XCOUNT := ARG_L;
1025:       end if;
1026:       RESULT(ARG_L-XCOUNT downto 0) := XARG(ARG_L downto XCOUNT);
1027:       RESULT(ARG_L downto (ARG_L - XCOUNT + 1)) := (others => XARG(ARG_L));
1028:     end if;
1029:     return RESULT;
1030:   end XSRA;
1031: 
1032:   function XROL (ARG: STD_LOGIC_VECTOR; COUNT: NATURAL) return STD_LOGIC_VECTOR
1033:       is
1034:     constant ARG_L: INTEGER := ARG'LENGTH-1;
1035:     alias XARG: STD_LOGIC_VECTOR(ARG_L downto 0) is ARG;
1036:     variable RESULT: STD_LOGIC_VECTOR(ARG_L downto 0) := XARG;
1037:     variable COUNTM: INTEGER;
1038:   begin
1039:     COUNTM := COUNT mod (ARG_L + 1);
1040:     if COUNTM /= 0 then
1041:       RESULT(ARG_L downto COUNTM) := XARG(ARG_L-COUNTM downto 0);
1042:       RESULT(COUNTM-1 downto 0) := XARG(ARG_L downto ARG_L-COUNTM+1);
1043:     end if;
1044:     return RESULT;
1045:   end XROL;
1046: 
1047:   function XROR (ARG: STD_LOGIC_VECTOR; COUNT: NATURAL) return STD_LOGIC_VECTOR
1048:       is
1049:     constant ARG_L: INTEGER := ARG'LENGTH-1;
1050:     alias XARG: STD_LOGIC_VECTOR(ARG_L downto 0) is ARG;
1051:     variable RESULT: STD_LOGIC_VECTOR(ARG_L downto 0) := XARG;
1052:     variable COUNTM: INTEGER;
1053:   begin
1054:     COUNTM := COUNT mod (ARG_L + 1);
1055:     if COUNTM /= 0 then
1056:       RESULT(ARG_L-COUNTM downto 0) := XARG(ARG_L downto COUNTM);
1057:       RESULT(ARG_L downto ARG_L-COUNTM+1) := XARG(COUNTM-1 downto 0);
1058:     end if;
1059:     return RESULT;
1060:   end XROR;
