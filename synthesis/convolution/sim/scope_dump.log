1127:   -- Id: A.1
1128:   function "abs" (ARG: SIGNED) return SIGNED is
1129:     constant ARG_LEFT: INTEGER := ARG'LENGTH-1;
1130:     alias XARG: SIGNED(ARG_LEFT downto 0) is ARG;
1131:     variable RESULT: SIGNED(ARG_LEFT downto 0);
1132:   begin
1133:     if ARG'LENGTH < 1 then return NAS;
1134:     end if;
1135:     RESULT := TO_01(XARG, 'X');
1136:     if (RESULT(RESULT'LEFT)='X') then return RESULT;
1137:     end if;
1138:     if RESULT(RESULT'LEFT) = '1' then
1139:       RESULT := -RESULT;
1140:     end if;
1141:     return RESULT;
1142:   end "abs";
1143: 
1144:   -- Id: A.2
1145:   function "-" (ARG: SIGNED) return SIGNED is
1146:     constant ARG_LEFT: INTEGER := ARG'LENGTH-1;
1147:     alias XARG: SIGNED(ARG_LEFT downto 0) is ARG;
1148:     variable RESULT, XARG01 : SIGNED(ARG_LEFT downto 0);
1149:     variable CBIT: STD_LOGIC := '1';
1150:   begin
1151:     if ARG'LENGTH < 1 then return NAS;
1152:     end if;
1153:     XARG01 := TO_01(ARG, 'X');
1154:     if (XARG01(XARG01'LEFT)='X') then return XARG01;
1155:     end if;
1156:     for I in 0 to RESULT'LEFT loop
1157:       RESULT(I) := not(XARG01(I)) xor CBIT;
1158:       CBIT := CBIT and not(XARG01(I));
1159:     end loop;
1160:     return RESULT;
1161:   end "-";
