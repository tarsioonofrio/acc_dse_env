2029:   -- USED INTERNALLY!
2030:   function justify (
2031:     value : in STRING;
2032:     justified : in SIDE := right;
2033:     field : in width := 0)
2034:     return STRING is
2035:     constant VAL_LEN : INTEGER := value'length;
2036:     variable result : STRING (1 to field) := (others => ' ');
2037:   begin  -- function justify
2038:     -- return value if field is too small
2039:     if VAL_LEN >= field then
2040:       return value;
2041:     end if;
2042:     if justified = left then
2043:       result(1 to VAL_LEN) := value;
2044:     elsif justified = right then
2045:       result(field - VAL_LEN + 1 to field) := value;
2046:     end if;
2047:     return result;
2048:   end function justify;
