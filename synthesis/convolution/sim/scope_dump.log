1597:   function "=" (L, R : INTEGER_VECTOR) return BOOLEAN is
1598:   begin
1599:     -- AVSREQ-156748: If both L and R are null-range INTEGER_VECTOR, then their length would match as 0.
1600:     -- So, return true for this case also.
1601:     if L'length /= R'length then --or L'length < 1 or R'length < 1 then
1602:       return false;
1603:     else
1604:       for i in l'range loop
1605:         if L(i) /= R(i) then
1606:           return false;
1607:         end if;
1608:       end loop;
1609:       return true;
1610:     end if;
