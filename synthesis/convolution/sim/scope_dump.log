1750:   function "<" (L, R : REAL_VECTOR) return BOOLEAN is
1751:   begin
1752:     if L'length /= R'length then
1753:       return L'length < R'length;
1754:     else
1755:       for i in l'range loop
1756:         if L(i) /= R(i) then
1757:           if L(i) < R(i) then
1758:             return true;
1759:           else
1760:             return false;
1761:           end if;
1762:         end if;
1763:       end loop;
1764:       return false;
1765:     end if;
1766:   end function "<";
