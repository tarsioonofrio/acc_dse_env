1417:       RNEG := TRUE;
1418:     else
1419:       XNUM := UNSIGNED(L);
1420:     end if;
1421:     if R(R'LEFT)='1' then
1422:       XDENOM := UNSIGNED(-R);
1423:     else
1424:       XDENOM := UNSIGNED(R);
1425:     end if;
1426:     DIVMOD(XNUM, XDENOM, FQUOT, FREMAIN);
1427:     if RNEG then
1428:       FREMAIN := "0"-FREMAIN;
1429:     end if;
1430:     return SIGNED(FREMAIN);
1431:   end "rem";
