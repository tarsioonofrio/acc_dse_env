 735: --      end if;
 736: --      return result;
 737: --      --synopsys synthesis_on
 738: --  end "xnor";
 739: 
 740:     function "xnor"  ( l,r : std_logic_vector ) return std_logic_vector is
 741:         -- pragma built_in SYN_XNOR
 742: 	-- pragma subpgm_id 203
 743:         --synopsys synthesis_off
 744:         alias lv : std_logic_vector ( 1 to l'length ) is l;
 745:         alias rv : std_logic_vector ( 1 to r'length ) is r;
 746:         variable result : std_logic_vector ( 1 to l'length );
 747:         --synopsys synthesis_on
 748:     begin
 749:         --synopsys synthesis_off
 750:         if ( l'length /= r'length ) then
 751:             assert false
 752:             report "arguments of overloaded 'xnor' operator are not of the same length"
 753:             severity failure;
 754:         else
 755:             for i in result'range loop
 756:                 result(i) := not_table(xor_table (lv(i), rv(i)));
 757:             end loop;
 758:         end if;
 759:         return result;
 760:         --synopsys synthesis_on
 761:     end "xnor";
 762:     ---------------------------------------------------------------------
 763:     function "xnor"  ( l,r : std_ulogic_vector ) return std_ulogic_vector is
 764:         -- pragma built_in SYN_XNOR
 765: 	-- pragma subpgm_id 196
 766:         --synopsys synthesis_off
 767:         alias lv : std_ulogic_vector ( 1 to l'length ) is l;
 768:         alias rv : std_ulogic_vector ( 1 to r'length ) is r;
 769:         variable result : std_ulogic_vector ( 1 to l'length );
 770:         --synopsys synthesis_on
 771:     begin
 772:         --synopsys synthesis_off
 773:         if ( l'length /= r'length ) then
 774:             assert false
 775:             report "arguments of overloaded 'xnor' operator are not of the same length"
 776:             severity failure;
 777:         else
 778:             for i in result'range loop
 779:                 result(i) := not_table(xor_table (lv(i), rv(i)));
 780:             end loop;
 781:         end if;
 782:         return result;
 783:         --synopsys synthesis_on
 784:     end "xnor";
