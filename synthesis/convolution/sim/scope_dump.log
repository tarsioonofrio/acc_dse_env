 791:     FUNCTION "not"  ( l : std_logic_vector ) RETURN std_logic_vector IS
 792:         -- pragma built_in SYN_NOT
 793: 	-- pragma subpgm_id 204
 794:         --synopsys synthesis_off
 795:         ALIAS lv : std_logic_vector ( 1 TO l'LENGTH ) IS l;
 796:         VARIABLE result : std_logic_vector ( 1 TO l'LENGTH ) := (OTHERS => 'X');
 797:         --synopsys synthesis_on
 798:     BEGIN
 799:         --synopsys synthesis_off
 800:         FOR i IN result'RANGE LOOP
 801:             result(i) := not_table( lv(i) );
 802:         END LOOP;
 803:         RETURN result;
 804:         --synopsys synthesis_on
 805:     END;
